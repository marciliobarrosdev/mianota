# Referência somente para mantenedores que executam o projeto fora da Lovable.
# O aluno que usa Remix não cria .env, banco ou projeto Supabase. A Lovable
# recria no Remix os seis bindings públicos gerados do .env versionado; nunca
# substitua esses bindings por valores de outro projeto e nunca inclua service role.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Identidade e suporte opcionais
VITE_APP_URL=
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_WHATSAPP_DISPLAY=
VITE_LEGAL_NAME=
VITE_LEGAL_DOCUMENT=
VITE_LEGAL_EMAIL=
VITE_LEGAL_ADDRESS=
VITE_OG_IMAGE_URL=
VITE_VAPID_PUBLIC_KEY=BNU7S6uUWADsreaeoW19xBsATtQIjbCR2qCH_c4_n6B8XjnvSGcWtGcjoKFRDNSqUL6LeYbCdbFShmOi3g5Jx3c

# Integrações (WhatsApp, Google, InfinitePay) são salvas em Master → Integrações.
# As variáveis abaixo são apenas fallback de compatibilidade no servidor.
# O Remix não copia esses valores.

# Provedor do WhatsApp (whatsmeow | evolution | meta):
# Para usar o microserviço Go nativo com whatsmeow:
WHATSAPP_PROVIDER=whatsmeow
WHATSAPP_GO_URL=http://localhost:8085
WHATSAPP_GO_API_KEY=mianota_whatsapp_go_secret_key
WHATSAPP_WEBHOOK_URL=http://localhost:8080/api/public/support-whatsapp-webhook
WHATSAPP_WEBHOOK_TOKEN=

# Obrigatórios para a Evolution API (quando WHATSAPP_PROVIDER=evolution):
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=

# Obrigatórios para o Google OAuth atual; o callback do clone também precisa
# estar autorizado no provedor Google:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Opcionais: configure somente o provedor de cobrança usado pelo clone.
# Sem um token e uma URL de checkout no plano, o proprietário ainda pode usar
# o sistema, mas vendas não liberarão clientes automaticamente:
# Resend E-mail Automático
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_DEFAULT_FROM="MIAnota <onboarding@resend.dev>"
RESEND_REPLY_TO=

# Lido por recursos server-side do projeto atual. Confirme o provisionamento
# no ambiente do clone antes de testar:
# SUPABASE_SERVICE_ROLE_KEY=

# Provedores de IA do MIAnota (Google Gemini, OpenRouter, DeepSeek, xAI/Grok, OpenAI, Anthropic)
# Configure no ambiente do backend somente as chaves dos provedores utilizados.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Nomes legados de compatibilidade (precedência: OPENAI_API_KEY > MARCIA_BYOK_OPENAI_API_KEY)
# MARCIA_BYOK_OPENAI_API_KEY=
# MARCIA_BYOK_ANTHROPIC_API_KEY=

# Opcionais ou dependentes do recurso habilitado:
# SUPPORT_WHATSAPP=
# VAPID_PRIVATE_KEY=
